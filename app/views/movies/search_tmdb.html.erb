<h2>Search in TMDb</h2>

<% flash.each do |key, value| %>
  <div class="alert alert-<%= key %>" role="alert">
    <%= value %>
  </div>
<% end %>

<%= form_tag search_path, method: :get, id: 'tmdb_form' do %>
  <div>
    <%= label_tag :title, 'Movie Name' %>
    <%= text_field_tag :title, params[:title], id: 'movie_title_field',
      placeholder: 'Manhunter' %>
  </div>

  <div>
    <%= label_tag :release_year, 'Release Year' %>
    <%= text_field_tag :release_year, params[:release_year], id: 'movie_year_field',
      placeholder: '1986' %>
  </div>

  <div>
    <%= radio_button_tag :language, 'en', params[:language] == 'en' %>
    <%= label_tag :language_en, 'English Only' %>
  </div>

  <div>
    <%= radio_button_tag :language, 'all',
      params[:language].blank? || params[:language] == 'all' %>
    <%= label_tag :language_all, 'All Languages' %>
  </div>

  <%= submit_tag 'Search', id: 'tmdb_submit', class: 'btn btn-warning' %>
<% end %>

<%= link_to 'Back to movie list', movies_path, class: 'btn btn-primary' %>

<% if @movies.present? %>
  <table class="table table-striped" id="search_movies">
    <thead>
      <tr>
        <th>Movie Title</th>
        <th>Release Date</th>
        <th>Description</th>
        <th>Add</th>
      </tr>
    </thead>
    <tbody>
      <% @movies.each do |movie| %>
        <tr>
          <td><%= movie.title %></td>
          <td><%= movie.release_date %></td>
          <td><%= movie.description %></td>
          <td>
            <%= form_tag add_movie_path, method: :post do %>
              <%= hidden_field_tag :title, movie.title %>
              <%= hidden_field_tag :rating, movie.rating %>
              <%= hidden_field_tag :release_date, movie.release_date %>
              <%= hidden_field_tag :description, movie.description %>
              <%= submit_tag 'Add movie', class: 'btn btn-success' %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>